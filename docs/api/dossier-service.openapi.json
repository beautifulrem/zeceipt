{
  "openapi": "3.1.0",
  "info": {
    "title": "zeceipt dossier service",
    "version": "0.1.0",
    "summary": "`zeceipt dossier serve`: check source-of-funds dossiers (zeceipt-dossier-v1) against the Zcash chain, for a compliance back office.",
    "description": "A self-hosted HTTP/1.1 service. No authentication, no TLS, no state: put it behind your own reverse proxy with TLS, authentication, a rate limit and a timeout. It listens on loopback unless started with `--allow-remote`. Request bodies are capped at 1 MiB. Transactions are fetched from zec.rocks, from `--endpoint`, or from `--raw-tx-dir` (offline). Every answer is JSON with `Cache-Control: no-store`; any other method or path is a 404. No CORS headers are sent, and a request whose `Origin` header is not allowed with `--allow-origin` is refused with 403 on every path, so a web page in an analyst's browser cannot drive the service with a simple cross-origin POST. Human documentation: docs/api/dossier-service.md. Written 2026-09-30 and checked against a running build that day, updated 2026-10-01 for abb0ef7 (anchored, untraced, undisclosed_input_min_zat, the consistent_offline and verified_partly_explained assurances, the 403, 415 and network 422 responses): crates/zeceipt-cli/src/main.rs (`serve_dossiers`) and crates/zeceipt-core/src/dossier.rs (`Report`). `security` is empty on purpose: the service itself authenticates no one; the proxy in front of it does.",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8787",
      "description": "The default --listen address"
    }
  ],
  "security": [],
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "health",
        "summary": "Liveness, and the dossier format this build reads",
        "responses": {
          "200": {
            "description": "Up",
            "headers": {
              "Cache-Control": {
                "description": "Always `no-store`.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "version"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "const": true
                    },
                    "version": {
                      "type": "string",
                      "const": "zeceipt-dossier-v1"
                    }
                  }
                },
                "example": {
                  "ok": true,
                  "version": "zeceipt-dossier-v1"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/v1/nonces": {
      "post": {
        "operationId": "issueNonce",
        "summary": "A fresh challenge nonce for a holder",
        "description": "`zeceipt-challenge-` and 16 random bytes (hex) from the OS generator, with the chain height and time it was issued at, for the case file. The service does not store it: pass it back as `expect_nonce` (and the height as `issued_at_height`) when the dossier arrives. The height comes from the service's own node and network (mainnet unless the service was started with --testnet or --regtest); it is null when no node answers, and always null with --raw-tx-dir, where `network` is also absent. No request body.",
        "responses": {
          "201": {
            "description": "A nonce",
            "headers": {
              "Cache-Control": {
                "description": "Always `no-store`.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Nonce"
                },
                "example": {
                  "issued_at": "2026-09-30T15:58:33Z",
                  "issued_at_height": 4422278,
                  "network": "test",
                  "nonce": "zeceipt-challenge-3b8f8c3d38f309ee7e8649c9a628066a"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/v1/dossiers/verify": {
      "post": {
        "operationId": "verifyDossier",
        "summary": "Check every claim of a dossier against the chain",
        "description": "The body is the dossier file exactly as received (UTF-8 JSON, at most 1 MiB), sent as `Content-Type: application/json` (anything else is a 415); `dossier_sha256` is the sha256 of these bytes. The service checks one network, mainnet unless started with --testnet or --regtest; a dossier whose `network` names another is refused with a 422 at stage `network`. A checked dossier is always a 200, whatever the outcome: read `assurance` (and `all_verified`, `controlled`, `untraced`, `undisclosed_input_min_zat`) and each claim's `status`. A transaction the node does not have or has only in its mempool makes the claims that rest on it `not_checked`; it is not an error.",
        "parameters": [
          {
            "name": "expect_nonce",
            "in": "query",
            "required": false,
            "description": "The nonce you issued. Every control claim must answer it. Without it, `controlled` is false. Taken literally: `+` becomes a space, no percent-decoding (zeceipt nonces are `[a-z0-9-]`).",
            "schema": {
              "type": "string",
              "pattern": "^zeceipt-challenge-[0-9a-f]{32}$"
            },
            "example": "zeceipt-challenge-eadb7e12661d3fe791dcb94683f3c8a8"
          },
          {
            "name": "issued_at_height",
            "in": "query",
            "required": false,
            "description": "The chain height when you issued the nonce: a control transaction mined below it fails. Not a non-negative integer: 400.",
            "schema": {
              "type": "integer",
              "minimum": 0
            },
            "example": 4421000
          }
        ],
        "requestBody": {
          "required": true,
          "description": "A zeceipt-dossier-v1 document (spec/dossier-v1.md §2). Parsed strictly: an unknown field or claim type is a 422.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Dossier"
              },
