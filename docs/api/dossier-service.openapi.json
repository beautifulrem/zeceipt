                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "the body is not UTF-8"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "413": {
            "description": "The body is over 1 MiB (1,048,576 bytes), or the upload broke off",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "the body is over 1 MiB, or broken"
                }
              }
            }
          },
          "415": {
            "description": "The `Content-Type` is not `application/json` (parameters such as `; charset=utf-8` allowed) or is missing",
            "headers": {
              "Cache-Control": {
                "description": "Always `no-store`.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "send the dossier as application/json"
                }
              }
            }
          },
          "422": {
            "description": "The dossier does not parse (stage `parse`), or its `network` is not the service's (stage `network`)",
            "headers": {
              "Cache-Control": {
                "description": "Always `no-store`.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParseError"
                },
                "examples": {
                  "parse": {
                    "summary": "A field the format does not have",
                    "value": {
                      "all_verified": false,
                      "error": "json: unknown field `extra`, expected one of `version`, `network`, `created`, `subject`, `nk`, `notes`, `receipts`, `claims` at line 1 column 79",
                      "stage": "parse"
                    }
                  },
                  "network": {
                    "summary": "A mainnet dossier sent to a service started with --testnet",
                    "value": {
                      "all_verified": false,
                      "stage": "network",
                      "error": "the dossier is for mainnet, and this checks testnet: check it without --testnet/--regtest, or against a node of its network"
                    }
                  }
                }
              }
            }
          },
          "502": {
            "description": "Fetching transactions failed with an error other than not found or not mined (every node unreachable, say)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "fetching transactions: all endpoints failed; last error: could not connect to http://127.0.0.1:9: transport error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "NotFound": {
        "description": "Any other method or path (there is no 405)",
        "headers": {
          "Cache-Control": {
            "description": "Always `no-store`.",
            "schema": {
              "type": "string",
              "const": "no-store"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "POST /v1/dossiers/verify, POST /v1/nonces or GET /healthz"
            }
          }
        }
      },
      "Forbidden": {
        "description": "The request carries an `Origin` header that `--allow-origin` does not name (checked first, on every path)",
        "headers": {
          "Cache-Control": {
            "description": "Always `no-store`.",
            "schema": {
              "type": "string",
              "const": "no-store"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "cross-origin requests are refused (start the service with --allow-origin to allow one)"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "ParseError": {
        "type": "object",
        "required": [
          "all_verified",
          "stage",
          "error"
        ],
        "properties": {
          "all_verified": {
            "type": "boolean",
            "const": false
          },
          "stage": {
            "type": "string",
            "enum": [
              "parse",
              "network"
            ],
            "description": "`parse`: the dossier does not parse; `network`: its `network` is not the service's"
          },
          "error": {
            "type": "string"
          }
        }
      },
      "Nonce": {
        "type": "object",
        "required": [
          "nonce",
          "issued_at_height",
          "issued_at"
        ],
        "properties": {
          "nonce": {
            "type": "string",
            "pattern": "^zeceipt-challenge-[0-9a-f]{32}$"
          },
          "issued_at_height": {
            "type": [
              "integer",
              "null"
            ],
            "description": "The service node's chain tip when issued; null if no node answered or with --raw-tx-dir"
          },
          "issued_at": {
            "type": "string",
            "format": "date-time"
          },
          "network": {
            "$ref": "#/components/schemas/Network",
            "description": "The service's network; absent with --raw-tx-dir"
          }
        }
      },
      "Network": {
        "type": "string",
        "enum": [
          "main",
          "test",
          "regtest"
        ]
      },
      "Status": {
        "type": "string",
        "enum": [
          "verified",
          "failed",
          "not_checked",
          "unproven"
        ],
        "description": "verified; failed: the chain data contradicts the claim; not_checked: a transaction is in the mempool or was not found (check again later); unproven: the data given cannot show it, and waiting will not change that"
      },
      "Dossier": {
        "type": "object",
        "description": "spec/dossier-v1.md §2. Unknown fields are refused.",
        "required": [
          "version",
          "network",
          "notes",
          "claims"
        ],
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "string",
            "const": "zeceipt-dossier-v1"
          },
          "network": {
            "$ref": "#/components/schemas/Network"
          },
          "created": {
            "type": "string",
            "description": "RFC 3339; informational"
          },
          "subject": {
            "type": "string",
            "description": "Free text from the holder; unauthenticated"
          },
          "nk": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$",
            "description": "The Orchard-family nullifier-deriving key; required by path, control, transparent_payment and deposit-with-funded_by claims"
          },
          "notes": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^zdp:1:"
            },
            "description": "id → zdp:1: note opening"
          },
          "receipts": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "description": "A zeceipt-v0 receipt (spec/receipt-v0.md)"
            }
          },
          "claims": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/Claim"
            }
          }
        }
      },
      "Claim": {
        "oneOf": [
          {
            "type": "object",
            "title": "origin",
            "required": [
              "type",
              "note"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "origin"
              },
              "note": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "title": "path",
            "required": [
              "type",
              "from",
              "to"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "path"
              },
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "title": "deposit",
            "required": [
              "type",
              "receipt"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "deposit"
              },
              "receipt": {
                "type": "string"
              },
              "funded_by": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          {
            "type": "object",
            "title": "control",
            "required": [
              "type",
              "nonce",
              "reply",
              "spent"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "control"
              },
              "nonce": {
                "type": "string"
              },
              "reply": {
                "type": "string"
              },
              "spent": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          {
            "type": "object",
            "title": "transparent_payment",
            "description": "A payment from disclosed notes to transparent output `output` of transaction `tx`.",
            "required": [
              "type",
              "tx",
              "output",
              "funded_by"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "transparent_payment"
              },
              "tx": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "output": {
                "type": "integer",
                "minimum": 0
              },
              "funded_by": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        ]
      },
      "NoteFact": {
        "type": "object",
        "required": [
          "txid",
          "pool",
          "action"
        ],
        "properties": {
          "txid": {
            "type": "string"
          },
          "pool": {
            "type": "string",
            "enum": [
              "ironwood",
              "orchard"
            ]
          },
          "action": {
            "type": "integer"
          },
          "height": {
            "type": "integer"
          },
          "recipient": {
            "type": "string"
          },
          "value_zat": {
            "type": "integer"
          },
          "memo": {
            "type": "string"
          },
          "nullifier": {
            "type": "string",
            "description": "Derived from the dossier's nk, when it is a valid key"
          },
          "spent_in": {
            "type": "string",
            "description": "The fetched transaction that spends this note: only then is the note shown to be the holder's"
          },
          "error": {
            "type": "string",
            "description": "Why the note did not open, or its transaction is absent"
          }
        }
      },
      "TransparentInput": {
        "type": "object",
        "required": [
          "prevout"
        ],
        "properties": {
          "prevout": {
            "type": "string",
            "description": "txid:index"
          },
          "address": {
            "type": "string",
            "description": "Read from the spent output's script in the previous transaction, never from scriptSig"
          },
          "value_zat": {
            "type": "integer"
          },
          "paid_in_claim": {
            "type": "integer",
            "description": "The index of this dossier's transparent_payment claim for the output this input spends"
          }
        }
      },
      "Funding": {
        "type": "object",
        "required": [
          "transparent_inputs",
          "shielded_actions",
          "sapling_spends",
          "from_disclosed"
        ],
        "properties": {
          "transparent_inputs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TransparentInput"
            }
          },
          "shielded_actions": {
            "type": "integer",
            "description": "Possible spends: every Orchard-family action carries a nullifier, real or dummy"
          },
          "sapling_spends": {
            "type": "integer"
          },
          "from_disclosed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ClaimResult": {
        "type": "object",
        "required": [
          "index",
          "kind",
          "status",
          "summary"
        ],
        "properties": {
          "index": {
            "type": "integer"
          },
          "kind": {
            "type": "string",
            "enum": [
              "origin",
              "path",
              "deposit",
              "control",
              "transparent_payment"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "summary": {
            "type": "string",
            "description": "One sentence for a person; wording may change between versions"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "funding": {
            "$ref": "#/components/schemas/Funding",
            "description": "Origin claims"
          },
          "value_zat": {
            "type": "integer",
            "description": "Control: the spent notes' value; deposit and transparent_payment: the amount paid"
          },
          "paid_to": {
            "type": "string",
            "description": "transparent_payment: the address the output pays, read from its script"
          },
          "undisclosed_input_min_zat": {
            "type": "integer",
            "minimum": 1,
            "description": "Omitted when 0: at least this much of what the claim's transaction paid came from notes the dossier does not disclose (spec §5.6)"
          }
        },
        "examples": [
          {
            "index": 12,
            "kind": "transparent_payment",
            "status": "verified",
            "summary": "The holder paid 0.05000000 TAZ to tm9vhDB1ebnsMzVnttVBpHEE5BPpoygSFhu (transparent output 0) in 52af3e0d…105e, from n5 (0.24743750 TAZ disclosed).",
            "details": [
              "The address and amount are read from the output's script on chain; the funding notes' nullifiers in that transaction tie the payment to the holder.",
              "Loaded without a height (from a file): the inclusion of 52af3e0d…105e, fcfde625…7f0b in the chain was not checked here."
            ],
            "value_zat": 5000000,
            "paid_to": "tm9vhDB1ebnsMzVnttVBpHEE5BPpoygSFhu"
          },
          {
            "index": 13,
            "kind": "origin",
            "status": "unproven",
            "summary": "0.04985000 TAZ arrived in note n10, in c28b6000…cefe, funded by 1 transparent input worth 0.05000000 TAZ from tm9vhDB1ebnsMzVnttVBpHEE5BPpoygSFhu, which the holder paid there from disclosed notes (transparent payment 52af3e0d…105e:0).",
            "details": [
              "Nothing here shows n10 is the holder's: its nullifier is in no supplied transaction, and the sender of a note knows its opening too. A path, deposit or control claim that spends it would show it.",
              "Loaded without a height (from a file): the inclusion of c28b6000…cefe in the chain was not checked here."
            ],
            "funding": {
              "transparent_inputs": [
                {
                  "prevout": "52af3e0da4b11854e48b5a0d25ac392ab6145616196ed196c0736e876b34105e:0",
                  "address": "tm9vhDB1ebnsMzVnttVBpHEE5BPpoygSFhu",
                  "value_zat": 5000000,
                  "paid_in_claim": 12
                }
              ],
              "shielded_actions": 2,
              "sapling_spends": 0,
              "from_disclosed": []
            }
          }
        ]
      },
      "Report": {
        "type": "object",
        "required": [
          "version",
          "network",
          "nk_proven",
          "controlled",
          "dossier_sha256",
          "notes",
          "claims",
          "all_verified",
          "assurance",
          "anchored",
          "undisclosed_input_min_zat",
          "disclosed",
          "does_not_prove"
        ],
        "properties": {
          "version": {
            "type": "string",
            "const": "zeceipt-dossier-report-v1"
          },
          "network": {
            "$ref": "#/components/schemas/Network"
          },
          "nk_proven": {
            "type": "boolean"
          },
          "controlled": {
            "type": "boolean",
            "description": "A control claim verified against expect_nonce; false without it"
          },
          "problems": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Dossier-level problems; any makes all_verified false"
          },
          "subject": {
            "type": "string"
          },
          "dossier_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "notes": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/NoteFact"
            }
          },
          "claims": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClaimResult"
            }
          },
          "all_verified": {
            "type": "boolean"
          },
          "anchored": {
            "type": "boolean",
            "description": "Every transaction the claims name came from a node, with a height. False offline (--raw-tx-dir): files carry no heights, and their inclusion in the chain is not checked"
          },
          "untraced": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Funding notes of a deposit, transparent payment or control (funded_by, spent) that no chain of verified path claims leads back to an origin claim (spec §5.6); omitted when empty"
          },
          "undisclosed_input_min_zat": {
            "type": "integer",
            "minimum": 0,
            "description": "A lower bound, summed once per transaction, on what the claims' transactions paid from notes the dossier does not disclose (spec §5.6): a small disclosed note \"funding\" a large payment shows here"
          },
          "assurance": {
            "type": "string",
            "enum": [
              "verified_with_control",
              "verified_history_only",
              "verified_partly_explained",
              "consistent_offline",
              "not_verified"
            ],
            "description": "The first that applies: not_verified (not all_verified); consistent_offline (every claim holds against the transactions supplied, but anchored is false: consistency with files, not verification against the chain); verified_partly_explained (some funds are untraced, or undisclosed_input_min_zat is above 0); verified_history_only (explained, but no control claim answers your nonce); verified_with_control. The CLI exits 4 for consistent_offline and verified_partly_explained"
          },
          "issued_at_height": {
            "type": "integer",
            "description": "The issued_at_height given"
          },
          "disclosed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "does_not_prove": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
