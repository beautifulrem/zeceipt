{
  "openapi": "3.1.0",
  "info": {
    "title": "Zeceipt payout console API",
    "version": "0.1.0",
    "description": "The console's HTTP API as built so far (walking skeleton, slices C2 and D1). Loopback-only until authentication exists: every operation can answer 403 (problem+json) from the request guard; every request needs a loopback Host (localhost, *.localhost, 127.0.0.1, [::1]); unsafe methods are refused when Sec-Fetch-Site is cross-site or same-site, or when Origin is present and is not this host's own origin. Errors are RFC 9457 problem details (application/problem+json) with an extension member `code`."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3000"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "health",
        "summary": "Liveness of the console and its database (IETF health+json)",
        "responses": {
          "200": {
            "description": "pass",
            "content": {
              "application/health+json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "fail",
            "content": {
              "application/health+json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/batches": {
      "get": {
        "operationId": "listBatches",
        "summary": "Batches of this deployment's org, newest first",
        "responses": {
          "200": {
            "description": "The list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "batches"
                  ],
                  "properties": {
                    "batches": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/BatchSummary"
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "500": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        }
      },
      "post": {
        "operationId": "createBatch",
        "summary": "Create a draft batch (moves no money). Not idempotent: a retry creates a second draft.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBatch"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                },
                "description": "/api/batches/{id}"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Batch"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "413": {
            "$ref": "#/components/responses/Problem"
          },
          "415": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          },
          "500": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/batches/{id}": {
      "get": {
        "operationId": "getBatch",
        "summary": "One batch with its items",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "UUIDv7"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The batch",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Batch"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "500": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/batches/{id}/submit": {
      "post": {
        "operationId": "submitBatch",
        "summary": "Pay the batch once through the wallet (hot custody). Idempotent per batch: the nonce batch/<id> is the key; a retry returns the recorded txid with Idempotent-Replayed: true. Every problem states `thisRequest` (sent_nothing or may_have_sent) and links `batchStatus`. A client disconnect does not abort a payment in progress.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "UUIDv7"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "confirmTotalZat"
                ],
                "properties": {
                  "confirmTotalZat": {
                    "type": "string",
                    "pattern": "^[0-9]{1,17}$",
                    "description": "Must equal the batch total (zatoshi)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Broadcast (fresh or replayed); confirmation pending",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                },
                "description": "/api/batches/{id}/status"
              },
              "Idempotent-Replayed": {
                "schema": {
                  "const": "true"
                },
                "description": "Present when no new payment was made"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "batchId",
                    "txid",
                    "replayed",
                    "via",
                    "status"
                  ],
                  "properties": {
                    "batchId": {
                      "type": "string"
                    },
                    "txid": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "replayed": {
                      "type": "boolean"
                    },
                    "via": {
                      "enum": [
                        "fresh",
                        "record",
                        "reconciled"
                      ]
                    },
                    "status": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "description": "payment_rejected, submission_in_flight (with Retry-After: 5; an attempt counts as running for up to 10 minutes), nonce_conflict, custody_external",
            "headers": {
              "Retry-After": {
                "$ref": "#/components/headers/RetryAfter"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "$ref": "#/components/responses/Problem"
          },
          "415": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          },
          "500": {
            "$ref": "#/components/responses/Problem"
          },
          "502": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "description": "store_busy (with Retry-After: 1) or not_ready (no Retry-After)",
            "headers": {
              "Retry-After": {
                "$ref": "#/components/headers/RetryAfter"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/batches/{id}/status": {
      "get": {
        "operationId": "getBatchStatus",
        "summary": "The batch's derived status (never stored): draft, submitting, retryable, needs_attention, pending, confirming, confirmed, receipts_partial, receipts_issued or expired, with the next action",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "UUIDv7"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "batchId",
                    "state",
                    "next",
                    "detail"
                  ],
                  "properties": {
                    "batchId": {
                      "type": "string"
                    },
                    "state": {
                      "enum": [
                        "draft",
                        "submitting",
                        "retryable",
                        "needs_attention",
                        "pending",
                        "confirming",
                        "confirmed",
                        "receipts_partial",
                        "receipts_issued",
                        "expired"
                      ]
                    },
                    "next": {
                      "enum": [
                        "submit",
                        "wait",
                        "issue_receipts",
                        "resend_expired",
                        "record_expiry",
                        "investigate",
                        "none"
                      ]
                    },
                    "detail": {
                      "type": "object",
                      "description": "txid, confirmations, required, receipts, items, error, expiresBy, cause, stale. `error` is the wallet's own recorded reason (e.g. 'Not enough funds…'): operator data, render it as plain text, never as HTML."
                    }
                  }
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "500": {
            "$ref": "#/components/responses/Problem"
          },
          "502": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "description": "store_busy (with Retry-After: 1) or not_ready (no Retry-After)",
            "headers": {
              "Retry-After": {
                "$ref": "#/components/headers/RetryAfter"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/batches/{id}/receipts": {
      "get": {
        "operationId": "listReceipts",
        "summary": "The batch's stored receipts, decrypted",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "UUIDv7"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The receipts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "batchId",
                    "receipts"
                  ],
                  "properties": {
                    "batchId": {
                      "type": "string"
                    },
                    "receipts": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Receipt"
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "500": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "description": "store_busy (with Retry-After: 1) or not_ready (no Retry-After)",
            "headers": {
              "Retry-After": {
                "$ref": "#/components/headers/RetryAfter"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "issueReceipts",
        "summary": "Issue one verified receipt per item once the payment has the configured confirmations (the batch's derived status decides). Idempotent: an issued batch returns its stored receipts without running the issuer again.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "UUIDv7"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Already issued, or this request lost a concurrent race and recorded nothing (inserted: []): the stored receipts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "batchId",
                    "txid",
                    "receipts"
                  ],
                  "properties": {
                    "batchId": {
                      "type": "string"
                    },
                    "txid": {
                      "type": "string"
                    },
                    "receipts": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Receipt"
                      }
                    },
                    "inserted": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      }
                    },
                    "existing": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      }
                    }
                  }
                }
              }
            }
          },
          "201": {
            "description": "Issued now: this request recorded at least one receipt",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "batchId",
                    "txid",
                    "inserted",
                    "existing",
                    "receipts"
                  ],
                  "properties": {
                    "batchId": {
                      "type": "string"
                    },
                    "txid": {
                      "type": "string"
                    },
                    "inserted": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      }
                    },
                    "existing": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      }
                    },
                    "receipts": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Receipt"
                      }
                    }
                  }
                }
              }
            }
          },
          "202": {
            "description": "Waiting: below the confirmation threshold (pending, not invalid)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "batchId",
                    "state",
                    "confirmations",
                    "required"
                  ],
                  "properties": {
                    "batchId": {
                      "type": "string"
                    },
                    "state": {
                      "const": "waiting"
                    },
                    "confirmations": {
                      "type": "integer"
                    },
                    "required": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "500": {
            "$ref": "#/components/responses/Problem"
          },
          "502": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "description": "store_busy (with Retry-After: 1) or not_ready (no Retry-After)",
            "headers": {
              "Retry-After": {
                "$ref": "#/components/headers/RetryAfter"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "Problem": {
        "description": "RFC 9457 problem details",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "required": [
          "status",
          "checks"
        ],
        "properties": {
          "status": {
            "enum": [
              "pass",
              "fail"
            ]
          },
          "checks": {
            "type": "object"
          }
        }
      },
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code"
        ],
        "properties": {
          "type": {
            "const": "about:blank"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "description": "host_not_allowed, cross_site_request, origin_mismatch, unsupported_media_type, body_too_large, bad_request, malformed_json, body_invalid, batch_invalid, batch_not_found, not_ready, internal, payment_rejected, outcome_unknown, submission_in_flight, nonce_conflict, store_busy, wallet_unavailable, custody_external, confirmation_mismatch, preflight_failed, issuance_failed, receipt_unverified, not_ready_for_receipts"
          },
          "problems": {
            "type": "array",
            "description": "batch_invalid: every domain problem",
            "items": {
              "type": "object",
              "required": [
                "code",
                "detail"
              ],
              "properties": {
                "code": {
                  "type": "string"
                },
                "index": {
                  "type": "integer"
                },
                "detail": {
                  "type": "string"
                }
              }
            }
          },
          "issues": {
            "type": "array",
            "description": "body_invalid: schema issues (path and message; never the submitted value)",
            "items": {
              "type": "object",
              "required": [
                "path",
                "message"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "thisRequest": {
            "enum": [
              "sent_nothing",
              "may_have_sent"
            ],
            "description": "Submit problems: what THIS request did. sent_nothing = this request broadcast nothing; may_have_sent = the outcome of this request's payment is unknown (outcome_unknown, or an unrecognised failure after the wallet backend was reached). Whether the batch was paid, by this or an earlier request, is only at batchStatus."
          },
          "batchStatus": {
            "type": "string",
            "description": "Submit problems: the batch's status route (RFC 9457's own `status` member is the HTTP status code)"
          },
          "state": {
            "type": "string",
            "description": "not_ready_for_receipts: the batch's derived state"
          },
          "next": {
            "type": "string",
            "description": "not_ready_for_receipts: the next action for that state"
          }
        }
      },
      "CreateBatch": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "items"
        ],
        "properties": {
          "title": {
            "type": "string",
            "description": "1–200 characters of plain text"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "payableId",
                "address",
                "zat",
                "memo"
              ],
              "properties": {
                "payableId": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "address": {
                  "type": "string",
                  "description": "Unified address for the deployment's network"
                },
                "zat": {
                  "type": "string",
                  "pattern": "^[0-9]{1,16}$",
                  "description": "Integer zatoshi as a decimal string (1 ZEC = 100000000 zat); strings because totals can exceed 2^53."
                },
                "memo": {
                  "type": "string",
                  "description": "1–512 UTF-8 bytes, unique within the batch"
                }
              }
            }
          }
        }
      },
      "Batch": {
        "type": "object",
        "required": [
          "id",
          "network",
          "title",
          "createdAt",
          "totalZat",
          "items"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "network": {
            "enum": [
              "main",
              "test",
              "regtest"
            ]
          },
          "title": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "totalZat": {
            "type": "string",
            "pattern": "^[0-9]{1,16}$",
            "description": "Integer zatoshi as a decimal string (1 ZEC = 100000000 zat); strings because totals can exceed 2^53."
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "idx",
                "payableId",
                "label",
                "address",
                "zat",
                "memo"
              ],
              "properties": {
                "idx": {
                  "type": "integer"
                },
                "payableId": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "address": {
                  "type": "string"
                },
                "zat": {
                  "type": "string",
                  "pattern": "^[0-9]{1,16}$",
                  "description": "Integer zatoshi as a decimal string (1 ZEC = 100000000 zat); strings because totals can exceed 2^53."
                },
                "memo": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "BatchSummary": {
        "type": "object",
        "required": [
          "id",
          "network",
          "title",
          "createdAt",
          "itemCount",
          "totalZat"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "network": {
            "enum": [
              "main",
              "test",
              "regtest"
            ]
          },
          "title": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "itemCount": {
            "type": "integer"
          },
          "totalZat": {
            "type": "string",
            "pattern": "^[0-9]+$"
          }
        }
      },
      "Receipt": {
        "type": "object",
        "required": [
          "idx",
          "payableId",
          "txid",
          "pool",
          "outputIndex",
          "valueZat",
          "recipient",
          "memo",
          "issuedAt",
          "verifiedAt"
        ],
        "properties": {
          "idx": {
            "type": "integer"
          },
          "payableId": {
            "type": "string"
          },
          "txid": {
            "type": "string"
          },
          "pool": {
            "type": "string"
          },
          "outputIndex": {
            "type": "integer"
          },
          "valueZat": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "recipient": {
            "type": "string"
          },
          "memo": {
            "type": "string"
          },
          "issuedAt": {
            "type": "string",
            "format": "date-time"
          },
          "verifiedAt": {
            "type": "string",
            "format": "date-time"
          },
          "url": {
            "type": "string",
            "description": "The shareable receipt link (like Stripe's receipt_url). It contains the output's OCK: a bearer capability. Absent when openError is set."
          },
          "receipt": {
            "type": "object",
            "description": "The signed receipt envelope (no challenge: console receipts are bearer documents). Absent when openError is set."
          },
          "openError": {
            "type": "string",
            "description": "This row's sealed payload did not open (e.g. seal_unknown_kid); the other rows are still returned"
          }
        }
      }
    },
    "headers": {
      "RetryAfter": {
        "description": "Seconds to wait before retrying (RFC 9110 §10.2.3)",
        "schema": {
          "type": "integer"
        }
      }
    }
  }
}
