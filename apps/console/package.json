{
  "name": "@zeceipt/console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Zeceipt payout console — Next.js app with its execution and issuance library",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "test": "node --test test/*.test.ts",
    "test:regtest": "ZECEIPT_REGTEST=1 node --test test/regtest.e2e.test.ts",
    "typecheck": "tsc --noEmit -p .",
    "test:app": "ZECEIPT_APP_E2E=1 node --test test/app.e2e.test.ts",
    "lint": "eslint . --max-warnings 0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.3",
    "geist": "^1.7.2",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents": false,
    "unrs-resolver": false
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
