# Zeceipt console configuration (all ZECEIPT_* variables; unknown ones are refused as typos).
# Demo mode: hot custody on a local regtest chain (docs/REGTEST_RUNBOOK.md). Copy to a real env file
# outside the repository and fill in ZECEIPT_WRAP_KEYS; never commit real keys.

# Custody (REQ-CON-17): hot = Zkool holds the seed, the console holds a viewing key only;
# external = an external signer, no Zkool settings allowed.
ZECEIPT_CUSTODY_MODE=hot
ZECEIPT_ZKOOL_URL=http://127.0.0.1:9000/graphql
ZECEIPT_ZKOOL_ACCOUNT=9
# Zkool has no authentication: keep it on loopback unless deliberately exposed.
ZECEIPT_ZKOOL_ALLOW_REMOTE=false

ZECEIPT_DB_PATH=/var/lib/zeceipt/console.db
ZECEIPT_ORG_ID=demo-org
ZECEIPT_NETWORK=regtest
ZECEIPT_CONFIRMATIONS=2
# Automatic receipts (REQ-CON-11): seconds between passes that issue receipts for confirmed batches; 0 = off (hot custody only).
ZECEIPT_AUTO_RECEIPTS_SECONDS=60

# Wrap keys for sealing secrets at rest: kid:base64(32 random bytes), comma-separated; the last one seals.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ZECEIPT_WRAP_KEYS=k1:REPLACE_WITH_BASE64_OF_32_RANDOM_BYTES

ZECEIPT_LIGHTWALLETD_URL=http://127.0.0.1:8137
ZECEIPT_BIN=/opt/zeceipt/bin/zeceipt
ZECEIPT_UFVK_FILE=/etc/zeceipt/issuer-ufvk.txt
ZECEIPT_ISSUER_KEY_FILE=/etc/zeceipt/issuer.key
ZECEIPT_ISSUER_KEY_ID=2026-09
# Where the public receipt page (packages/verify/r/) is served: links are <host>/r#<receipt>. Required, no default:
# the page that host serves can read the link's fragment, so use a site you control. https, or http on loopback only
# (a local `npm run demo`). A path prefix is allowed.
ZECEIPT_RECEIPT_HOST=http://127.0.0.1:8787
# The ZEC/USD source for rate locks: a Kraken-format Ticker URL. Optional; this is the default. https, or http
# on loopback only (tests, a local mirror). On a machine behind an HTTP proxy, start the console with
# NODE_USE_ENV_PROXY=1: Node's fetch ignores HTTPS_PROXY otherwise, and every lock fails closed (502).
ZECEIPT_RATE_URL=https://api.kraken.com/0/public/Ticker?pair=ZECUSD
# Submit is refused when ZEC/USD has moved more than this many basis points since the lock (REQ-CON-21).
# Optional; 300 (3%) is the default. Integer 1..2000.
ZECEIPT_RATE_MAX_DRIFT_BPS=300
