{
  "name": "@zeceipt/verify",
  "version": "0.1.0",
  "description": "Verify Zeceipt receipts (per-output disclosures of shielded Zcash payments) locally in the browser or Node",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zeceipt/zeceipt"
  },
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "files": [
    "src",
    "pkg",
    "LICENSE"
  ],
  "scripts": {
    "build:wasm": "../../scripts/build_wasm.sh",
    "demo": "python3 -m http.server 8787 --directory .",
    "test": "node test/verify.mjs",
    "test:page": "ZECEIPT_BROWSER_E2E=1 node test/page.e2e.mjs",
    "test:pack": "node test/pack.mjs",
    "test:timing": "node test/timing.mjs"
  },
  "keywords": [
    "zcash",
    "receipt",
    "zip311",
    "ironwood",
    "privacy",
    "proof-of-payment"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0"
  }
}
